///|
/// Module M8 (Part 1) — Strict Positivity, Cantor/Girard Negative-Occurrence Guard,
/// 64-Bit Constructor Recursive Bitmasks, and Sparse Nested Parametricity (POPL/ICFP 2026).

///|
pub(all) suberror InductiveError {
  NonStrictlyPositiveSelf(String, Int32)
  SelfInNestedNonSPPosition(String, String, Int32)
  SelfInIndexArgument(String, Int32)
  UnknownNestedContainer(String)
  ConstructorArityOverflow(Int32)
  InductiveInductiveIndexMismatch(String)
  InductiveRecursiveDomainError(String)
}

///|
/// Variance / Polarity Lattice for Type Parameters in Inductive Declarations:
/// `Unused` < `StrictlyPositive` < `Positive` < `Mixed`, and `Negative` < `Mixed`.
#derive(Eq, Hash, Compare, Debug)
pub(all) enum ParamPolarity {
  Unused
  StrictlyPositive
  Positive
  Negative
  Mixed
}

///|
pub extend ParamPolarity with Eq::{equal, not_equal}

///|
pub extend ParamPolarity with Hash::{hash_combine, hash}

///|
pub extend ParamPolarity with Compare::{compare, op_lt, op_le, op_ge, op_gt}

///|
pub extend ParamPolarity with @debug.Debug::{to_repr}

///|
pub impl Show for ParamPolarity with fn output(self, logger) {
  match self {
    Unused => logger.write_string("Unused")
    StrictlyPositive => logger.write_string("StrictlyPositive")
    Positive => logger.write_string("Positive")
    Negative => logger.write_string("Negative")
    Mixed => logger.write_string("Mixed")
  }
}

///|
pub extend ParamPolarity with Show::{to_string, output}

///|
pub fn ParamPolarity::join(
  self : ParamPolarity,
  other : ParamPolarity,
) -> ParamPolarity {
  if self == other {
    return self
  }
  match (self, other) {
    (Unused, x) | (x, Unused) => x
    (StrictlyPositive, Positive) | (Positive, StrictlyPositive) => Positive
    _ => Mixed
  }
}

///|
/// Crossing to the LEFT of a function arrow `A -> B`:
/// - `Unused` stays `Unused`
/// - `StrictlyPositive` or `Positive` flips to `Negative`
/// - `Negative` flips to `Positive` (NOTE: `Positive`, NEVER `StrictlyPositive`! Double negation `(X -> 0) -> 0` is positive, NOT strictly positive!)
/// - `Mixed` stays `Mixed`
pub fn ParamPolarity::negate_left_of_arrow(
  self : ParamPolarity,
) -> ParamPolarity {
  match self {
    Unused => Unused
    StrictlyPositive | Positive => Negative
    Negative => Positive
    Mixed => Mixed
  }
}

///|
/// Type expressions inside an Inductive Constructor Signature.
#derive(Eq, Debug)
pub(all) enum SPTypeExpr {
  SPConst(String)
  SPParam(Int32)
  SPSelf(Array[SPTypeExpr])
  SPProd(SPTypeExpr, SPTypeExpr)
  SPSum(SPTypeExpr, SPTypeExpr)
  SPArrow(SPTypeExpr, SPTypeExpr)
  SPNestedApp(String, Array[SPTypeExpr])
}

///|
pub extend SPTypeExpr with Eq::{equal, not_equal}

///|
pub extend SPTypeExpr with @debug.Debug::{to_repr}

///|
/// Constructor specification `c : (a_0 : T_0) -> ... -> (a_{k-1} : T_{k-1}) -> I(result_indices)`.
#derive(Eq, Debug)
pub(all) struct InductiveCtorDecl {
  name : String
  arg_types : Array[SPTypeExpr]
  result_indices : Array[SPTypeExpr]
}

///|
pub extend InductiveCtorDecl with Eq::{equal, not_equal}

///|
pub extend InductiveCtorDecl with @debug.Debug::{to_repr}

///|
/// Inductive family declaration with `num_params` parameters.
#derive(Eq, Debug)
pub(all) struct InductiveDecl {
  name : String
  num_params : Int32
  ctors : Array[InductiveCtorDecl]
}

///|
pub extend InductiveDecl with Eq::{equal, not_equal}

///|
pub extend InductiveDecl with @debug.Debug::{to_repr}

///|
/// Certified O(1) Bit-Summary for a Validated Constructor:
/// - `rec_arg_mask`: bit `i` is 1 iff `arg_types[i]` contains recursive `SPSelf`
/// - `nested_rec_mask`: bit `i` is 1 iff `arg_types[i]` uses nested container recursion
/// - `sparse_ih_count`: exact number of induction hypotheses generated by Sparse Parametricity!
#derive(Eq, Debug)
pub(all) struct CertifiedCtorSummary {
  name : String
  arity : Int32
  rec_arg_mask : UInt64
  nested_rec_mask : UInt64
  sparse_ih_count : Int32
}

///|
pub extend CertifiedCtorSummary with Eq::{equal, not_equal}

///|
pub extend CertifiedCtorSummary with @debug.Debug::{to_repr}

///|
/// O(1) test: is this constructor a non-recursive base/leaf constructor?
pub fn CertifiedCtorSummary::is_leaf(self : CertifiedCtorSummary) -> Bool {
  self.rec_arg_mask == 0UL
}

///|
/// Certified Inductive Family Certificate:
/// `sp_param_mask` has bit `p` set iff parameter `p` occurs ONLY in strictly positive positions
/// across ALL constructors, allowing this inductive type to be safely nested inside future types!
#derive(Eq, Debug)
pub(all) struct CertifiedInductiveSummary {
  name : String
  sp_param_mask : UInt64
  param_polarities : Array[ParamPolarity]
  ctor_summaries : Array[CertifiedCtorSummary]
}

///|
pub extend CertifiedInductiveSummary with Eq::{equal, not_equal}

///|
pub extend CertifiedInductiveSummary with @debug.Debug::{to_repr}

///|
fn mentions_self(e : SPTypeExpr) -> Bool {
  match e {
    SPConst(_) | SPParam(_) => false
    SPSelf(_) => true
    SPProd(a, b) | SPSum(a, b) | SPArrow(a, b) =>
      mentions_self(a) || mentions_self(b)
    SPNestedApp(_, args) => {
      for x in args {
        if mentions_self(x) {
          return true
        }
      }
      false
    }
  }
}

///|
/// Verify that `e` is STRICTLY POSITIVE in `SPSelf`:
/// - `SPArrow(dom, cod)`: `dom` MUST NOT mention `SPSelf` at all (`!mentions_self(dom)`),
///   and `cod` must be strictly positive in `SPSelf`!
/// - `SPSelf(indices)`: `indices` MUST NOT mention `SPSelf` (no unguarded self-indexing)!
/// - `SPNestedApp(cname, args)`: `cname` must be in `env_sp_masks`, and for every arg `j`
///   that mentions `SPSelf`, bit `j` MUST be set in `env_sp_masks[cname]` and `args[j]` must be strictly positive!
/// Returns `(has_direct_or_exp_self, has_nested_self)`.
fn verify_strictly_positive_arg(
  ctor_name : String,
  arg_idx : Int32,
  e : SPTypeExpr,
  env_sp_masks : Map[String, UInt64],
) -> (Bool, Bool) raise InductiveError {
  match e {
    SPConst(_) | SPParam(_) => (false, false)
    SPSelf(indices) => {
      for idx_e in indices {
        if mentions_self(idx_e) {
          raise InductiveError::SelfInIndexArgument(ctor_name, arg_idx)
        }
      }
      (true, false)
    }
    SPProd(a, b) | SPSum(a, b) => {
      let (d1, n1) = verify_strictly_positive_arg(
        ctor_name, arg_idx, a, env_sp_masks,
      )
      let (d2, n2) = verify_strictly_positive_arg(
        ctor_name, arg_idx, b, env_sp_masks,
      )
      (d1 || d2, n1 || n2)
    }
    SPArrow(dom, cod) => {
      if mentions_self(dom) {
        raise InductiveError::NonStrictlyPositiveSelf(ctor_name, arg_idx)
      }
      verify_strictly_positive_arg(ctor_name, arg_idx, cod, env_sp_masks)
    }
    SPNestedApp(cname, args) =>
      match env_sp_masks.get(cname) {
        None => raise InductiveError::UnknownNestedContainer(cname)
        Some(sp_mask) => {
          let mut any_self = false
          for j = 0; j < args.length(); j = j + 1 {
            if mentions_self(args[j]) {
              let allowed = j < 64 && ((sp_mask >> j) & 1UL) != 0UL
              if !allowed {
                raise InductiveError::SelfInNestedNonSPPosition(
                  ctor_name, cname, j,
                )
              }
              let _ = verify_strictly_positive_arg(
                ctor_name,
                arg_idx,
                args[j],
                env_sp_masks,
              )
              any_self = true
            }
          }
          (any_self, any_self)
        }
      }
  }
}

///|
fn infer_param_polarity(
  p : Int32,
  e : SPTypeExpr,
  env_sp_masks : Map[String, UInt64],
) -> ParamPolarity {
  match e {
    SPConst(_) => Unused
    SPParam(q) => if p == q { StrictlyPositive } else { Unused }
    SPSelf(indices) => {
      let mut acc = Unused
      for idx_e in indices {
        if infer_param_polarity(p, idx_e, env_sp_masks) != Unused {
          acc = Mixed
        }
      }
      acc
    }
    SPProd(a, b) | SPSum(a, b) =>
      infer_param_polarity(p, a, env_sp_masks).join(
        infer_param_polarity(p, b, env_sp_masks),
      )
    SPArrow(dom, cod) =>
      infer_param_polarity(p, dom, env_sp_masks)
      .negate_left_of_arrow()
      .join(infer_param_polarity(p, cod, env_sp_masks))
    SPNestedApp(cname, args) => {
      let sp_mask = match env_sp_masks.get(cname) {
        Some(m) => m
        None => 0UL
      }
      let mut acc = Unused
      for j = 0; j < args.length(); j = j + 1 {
        let sub_pol = infer_param_polarity(p, args[j], env_sp_masks)
        if sub_pol != Unused {
          let is_sp_slot = j < 64 && ((sp_mask >> j) & 1UL) != 0UL
          let mapped = if is_sp_slot && sub_pol == StrictlyPositive {
            StrictlyPositive
          } else {
            Mixed
          }
          acc = acc.join(mapped)
        }
      }
      acc
    }
  }
}

///|
/// Certify an `InductiveDecl` for Strict Positivity, Sparse Induction Hypothesis Count,
/// and 64-Bit Strictly Positive Parameter Mask (`sp_param_mask`).
pub fn check_strict_positivity(
  decl : InductiveDecl,
  env_sp_masks : Map[String, UInt64],
) -> CertifiedInductiveSummary raise InductiveError {
  let param_pols : Array[ParamPolarity] = Array::make(decl.num_params, Unused)
  let ctor_sums : Array[CertifiedCtorSummary] = []

  for ctor in decl.ctors {
    let arity = ctor.arg_types.length()
    if arity > 64 {
      raise InductiveError::ConstructorArityOverflow(arity)
    }
    for res_idx in ctor.result_indices {
      if mentions_self(res_idx) {
        raise InductiveError::SelfInIndexArgument(ctor.name, -1)
      }
    }
    let mut rec_mask = 0UL
    let mut nested_mask = 0UL
    let mut ih_count = 0
    for i = 0; i < arity; i = i + 1 {
      let arg_ty = ctor.arg_types[i]
      let (is_rec, is_nested) = verify_strictly_positive_arg(
        ctor.name,
        i,
        arg_ty,
        env_sp_masks,
      )
      if is_rec {
        rec_mask = rec_mask | (1UL << i)
        ih_count = ih_count + 1
      }
      if is_nested {
        nested_mask = nested_mask | (1UL << i)
      }
      for p = 0; p < decl.num_params; p = p + 1 {
        param_pols[p] = param_pols[p].join(
          infer_param_polarity(p, arg_ty, env_sp_masks),
        )
      }
    }
    ctor_sums.push({
      name: ctor.name,
      arity,
      rec_arg_mask: rec_mask,
      nested_rec_mask: nested_mask,
      sparse_ih_count: ih_count,
    })
  }

  let mut sp_mask = 0UL
  for p = 0; p < decl.num_params; p = p + 1 {
    if p < 64 && (param_pols[p] == Unused || param_pols[p] == StrictlyPositive) {
      sp_mask = sp_mask | (1UL << p)
    }
  }
  {
    name: decl.name,
    sp_param_mask: sp_mask,
    param_polarities: param_pols,
    ctor_summaries: ctor_sums,
  }
}
