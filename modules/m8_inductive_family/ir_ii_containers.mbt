///|
/// Module M8 (Part 2):
/// 1. Dybjer-Setzer Inductive-Recursive (`IR`) Codes & Simultaneous Closed Universe `(IRU, ir_decode)`
/// 2. Forsberg-Setzer / Kaposi-Kovács Inductive-Inductive (`II`) Intrinsic `(IICtx, IITy)` & Recursive-Recursive Eliminator
/// 3. Polynomial Container `WTree` & Catamorphism (`cata_w`).

///|
/// ============================================================================
/// 1. Dybjer-Setzer Generic Inductive-Recursive Code (`IRCode[D]`) & Algebra
/// ============================================================================
/// Defines simultaneously an inductive type `U_γ` (`IRNode`) AND a recursive decoding `decode : U_γ -> D`
/// where `IRDelta` branches over the DECODED values `k |-> decode(children(k))`!
pub(all) enum IRCode[D] {
  IRIota(D)
  IRSigma(Int32, (Int32) -> IRCode[D])
  IRDelta(Int32, ((Int32) -> D) -> IRCode[D])
}

///|
/// Inhabitant of the initial algebra `(U_γ, T_γ)` generated by `IRCode[D]`.
pub(all) enum IRNode {
  IREnd
  IRTag(Int32, IRNode)
  IRBranch(Array[IRNode], IRNode)
}

///|
/// Simultaneous Dybjer-Setzer Decoding Function `T_γ : U_γ -> D`!
/// Notice how in the `IRDelta` clause, `rest_code` is computed by passing the recursive
/// decoding `i => ir_eval_code(code_fn(...), children[i])` into the code continuation!
pub fn[D] ir_decode_generic(
  code : IRCode[D],
  node : IRNode,
) -> D raise InductiveError {
  match (code, node) {
    (IRIota(d), IREnd) => d
    (IRSigma(bound, next_fn), IRTag(tag, rest)) => {
      if tag < 0 || tag >= bound {
        raise InductiveError::InductiveRecursiveDomainError(
          "IRSigma tag \{tag} out of [0, \{bound})",
        )
      }
      ir_decode_generic(next_fn(tag), rest)
    }
    (IRDelta(arity, next_with_decoded), IRBranch(children, rest)) => {
      if children.length() != arity {
        raise InductiveError::InductiveRecursiveDomainError(
          "IRDelta arity mismatch: got \{children.length()}, want \{arity}",
        )
      }
      // Wait: in generic IR over a fixed universe code `root_code`, children live in `U_root`;
      // here for self-contained finite index codes we also provide concrete closed Tarski Universe `IRUni` below!
      let _ = next_with_decoded
      let _ = rest
      raise InductiveError::InductiveRecursiveDomainError(
        "Use ir_decode_with_root for recursive IRDelta",
      )
    }
    _ =>
      raise InductiveError::InductiveRecursiveDomainError(
        "Mismatched IRCode / IRNode constructor",
      )
  }
}

///|
/// Full Simultaneous Dybjer-Setzer Decoder `T_root : U_root -> D` where recursive subtrees
/// in `IRDelta` are decoded against `root_code` and fed back into `next_with_decoded`!
pub fn[D] ir_decode_with_root(
  root_code : IRCode[D],
  cur_code : IRCode[D],
  node : IRNode,
) -> D raise InductiveError {
  match (cur_code, node) {
    (IRIota(d), IREnd) => d
    (IRSigma(bound, next_fn), IRTag(tag, rest)) => {
      if tag < 0 || tag >= bound {
        raise InductiveError::InductiveRecursiveDomainError(
          "IRSigma tag \{tag} out of bounds",
        )
      }
      ir_decode_with_root(root_code, next_fn(tag), rest)
    }
    (IRDelta(arity, next_with_decoded), IRBranch(children, rest)) => {
      if children.length() != arity {
        raise InductiveError::InductiveRecursiveDomainError(
          "IRDelta arity mismatch",
        )
      }
      let decoded_children : Array[D] = []
      for c in children {
        decoded_children.push(ir_decode_with_root(root_code, root_code, c))
      }
      let next_code = next_with_decoded(fn(k) { decoded_children[k] })
      ir_decode_with_root(root_code, next_code, rest)
    }
    _ =>
      raise InductiveError::InductiveRecursiveDomainError(
        "IRCode / IRNode shape mismatch",
      )
  }
}

///|
/// Canonical Closed Inductive-Recursive Tarski Universe `(IRUni, IRElem)` with Exact Cardinality Decoding!
/// Demonstrates genuine Induction-Recursion in action:
/// - `UFin(n)` decodes to finite set `{0 .. n-1}` of cardinality `n`
/// - `USigmaIR(a, fam)` has `a : IRUni` and `fam : Array[IRUni]` of length `ir_cardinality(a)`!
///   Notice that the WELL-FORMEDNESS of `USigmaIR(a, fam)` DEPENDS ON `ir_cardinality(a)`,
///   while `ir_cardinality(USigmaIR(a, fam))` sums `ir_cardinality(fam[i])` — mutual Induction-Recursion!
/// - `UPiIR(a, fam)` has `a : IRUni` and `fam : Array[IRUni]` of length `ir_cardinality(a)`,
///   with cardinality `∏_{i=0}^{|El(a)|-1} |El(fam[i])|`!
#derive(Eq, Debug)
pub(all) enum IRUni {
  UFin(Int32)
  USigmaIR(IRUni, Array[IRUni])
  UPiIR(IRUni, Array[IRUni])
}

///|
pub extend IRUni with Eq::{equal, not_equal}

///|
pub extend IRUni with @debug.Debug::{to_repr}

///|
/// Simultaneous Mutual Check & Cardinality Decoder `|El(u)|` for the Inductive-Recursive Universe `IRUni`!
pub fn ir_check_and_decode_card(u : IRUni) -> Int32 raise InductiveError {
  match u {
    UFin(n) => {
      if n < 0 {
        raise InductiveError::InductiveRecursiveDomainError("Negative UFin")
      }
      n
    }
    USigmaIR(a, fam) => {
      let card_a = ir_check_and_decode_card(a)
      if fam.length() != card_a {
        raise InductiveError::InductiveRecursiveDomainError(
          "USigmaIR family length \{fam.length()} != |El(a)| = \{card_a}",
        )
      }
      let mut sum = 0
      for b in fam {
        sum = sum + ir_check_and_decode_card(b)
      }
      sum
    }
    UPiIR(a, fam) => {
      let card_a = ir_check_and_decode_card(a)
      if fam.length() != card_a {
        raise InductiveError::InductiveRecursiveDomainError(
          "UPiIR family length \{fam.length()} != |El(a)| = \{card_a}",
        )
      }
      let mut prod = 1
      for b in fam {
        prod = prod * ir_check_and_decode_card(b)
      }
      prod
    }
  }
}

///|
/// ============================================================================
/// 2. Forsberg-Setzer / Kaposi-Kovács Inductive-Inductive (`II`) System `(IICtx, IITy)`
/// ============================================================================
/// Intrinsic Syntax of Dependent Contexts & Types:
/// - Sort 1: `IICtx` (`IINil` | `IISnoc(Γ : IICtx, A : IITy)`)
/// - Sort 2: `IITy` indexed over `IICtx`:
///     * `IIBase(Γ, label)` : `IITy(Γ)`
///     * `IIPi(Γ, A, B)`    : `IITy(Γ)` when `A : IITy(Γ)` and `B : IITy(IISnoc(Γ, A))`!
///     * `IISigma(Γ, A, B)` : `IITy(Γ)` when `A : IITy(Γ)` and `B : IITy(IISnoc(Γ, A))`!
/// Notice the genuine mutual dependency: `IISnoc` (constructor of `IICtx`) refers to `IITy`,
/// while `IIPi` / `IISigma` (constructors of `IITy`) refer to `IISnoc` in the index of `B`!
#derive(Eq, Debug)
pub(all) enum IICtx {
  IINil
  IISnoc(IICtx, IITy)
}

///|
pub extend IICtx with Eq::{equal, not_equal}

///|
pub extend IICtx with @debug.Debug::{to_repr}

///|
#derive(Eq, Debug)
pub(all) enum IITy {
  IIBase(IICtx, Int32)
  IIPi(IICtx, IITy, IITy)
  IISigma(IICtx, IITy, IITy)
}

///|
pub extend IITy with Eq::{equal, not_equal}

///|
pub extend IITy with @debug.Debug::{to_repr}

///|
/// Extract the `IICtx` index of an `IITy`.
pub fn ii_ty_ctx(ty : IITy) -> IICtx {
  match ty {
    IIBase(g, _) | IIPi(g, _, _) | IISigma(g, _, _) => g
  }
}

///|
/// Mutual Inductive-Inductive Well-Formedness Checker (`check_ii_ctx` & `check_ii_ty`)!
pub fn check_ii_ctx(ctx : IICtx) -> Unit raise InductiveError {
  match ctx {
    IINil => ()
    IISnoc(g, a) => {
      check_ii_ctx(g)
      check_ii_ty(g, a)
    }
  }
}

///|
pub fn check_ii_ty(
  expected_ctx : IICtx,
  ty : IITy,
) -> Unit raise InductiveError {
  if ii_ty_ctx(ty) != expected_ctx {
    raise InductiveError::InductiveInductiveIndexMismatch(
      "Context index mismatch",
    )
  }
  match ty {
    IIBase(g, card) => {
      if card < 0 {
        raise InductiveError::InductiveInductiveIndexMismatch(
          "Negative base card",
        )
      }
      check_ii_ctx(g)
    }
    IIPi(g, a, b) | IISigma(g, a, b) => {
      check_ii_ty(g, a)
      check_ii_ty(IISnoc(g, a), b)
    }
  }
}

///|
/// Theorem 8.3 (Recursive-Recursive Eliminator for `(IICtx, IITy)`):
/// Simultaneously folds `IICtx -> CVal` and `(ctx : IICtx, CVal, IITy) -> TVal`
/// where the eliminator on `B : IITy(IISnoc(Γ, A))` receives `on_snoc(elim_ctx(Γ), elim_ty(A))`!
pub fn[CVal, TVal] ii_elim_ctx(
  ctx : IICtx,
  on_nil : CVal,
  on_snoc : (CVal, TVal) -> CVal,
  on_base : (CVal, Int32) -> TVal,
  on_pi : (CVal, TVal, TVal) -> TVal,
  on_sigma : (CVal, TVal, TVal) -> TVal,
) -> CVal {
  match ctx {
    IINil => on_nil
    IISnoc(g, a) => {
      let cg = ii_elim_ctx(g, on_nil, on_snoc, on_base, on_pi, on_sigma)
      let ta = ii_elim_ty(a, cg, on_nil, on_snoc, on_base, on_pi, on_sigma)
      on_snoc(cg, ta)
    }
  }
}

///|
pub fn[CVal, TVal] ii_elim_ty(
  ty : IITy,
  cg : CVal,
  on_nil : CVal,
  on_snoc : (CVal, TVal) -> CVal,
  on_base : (CVal, Int32) -> TVal,
  on_pi : (CVal, TVal, TVal) -> TVal,
  on_sigma : (CVal, TVal, TVal) -> TVal,
) -> TVal {
  match ty {
    IIBase(_, card) => on_base(cg, card)
    IIPi(_, a, b) => {
      let ta = ii_elim_ty(a, cg, on_nil, on_snoc, on_base, on_pi, on_sigma)
      let cg_ext = on_snoc(cg, ta)
      let tb = ii_elim_ty(b, cg_ext, on_nil, on_snoc, on_base, on_pi, on_sigma)
      on_pi(cg, ta, tb)
    }
    IISigma(_, a, b) => {
      let ta = ii_elim_ty(a, cg, on_nil, on_snoc, on_base, on_pi, on_sigma)
      let cg_ext = on_snoc(cg, ta)
      let tb = ii_elim_ty(b, cg_ext, on_nil, on_snoc, on_base, on_pi, on_sigma)
      on_sigma(cg, ta, tb)
    }
  }
}

///|
/// ============================================================================
/// 3. Polynomial Container W-Types (`WTree[S]`) & Initial Algebra Catamorphism
/// ============================================================================
#derive(Eq, Debug)
pub(all) enum WTree[S] {
  WSup(S, Array[WTree[S]])
}

///|
pub extend WTree with Eq::{equal, not_equal}

///|
pub extend WTree with @debug.Debug::{to_repr}

///|
/// Initial F-Algebra Catamorphism `cata_w : (∀s. (P(s) -> R) -> R) -> W(S, P) -> R`.
pub fn[S, R] cata_w(alg : (S, Array[R]) -> R, tree : WTree[S]) -> R {
  match tree {
    WSup(shape, kids) => {
      let mapped : Array[R] = []
      for k in kids {
        mapped.push(cata_w(alg, k))
      }
      alg(shape, mapped)
    }
  }
}

///|
/// Well-founded Brouwer Rank (1 + max child rank) via `cata_w`.
pub fn[S] w_tree_height(tree : WTree[S]) -> Int32 {
  cata_w(
    fn(_s, child_heights) {
      let mut mx = 0
      for h in child_heights {
        if h > mx {
          mx = h
        }
      }
      1 + mx
    },
    tree,
  )
}
